      <aliases enabled='yes' />
      <column caption='Total Users' datatype='integer' name='[Calculation_1736419188864299010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id])' />
      </column>
      <column caption='Avg Listing Time' datatype='real' name='[Calculation_1736419188867915779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([listening_time])' />
      </column>
      <column caption='Avg Skip Rate' datatype='real' name='[Calculation_1736419188871503876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([skip_rate]) * 100' />
      </column>
      <column caption='Offline Listening Usage (%)' datatype='real' name='[Calculation_1736419188872527877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([offline_listening]) * 100' />
      </column>
      <column caption='Total Churned Users' datatype='integer' name='[Calculation_25895755823443968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_churned] = 1 THEN [user_id] END)' />
      </column>
      <column caption='Overall Churn Rate (%)' datatype='real' name='[Calculation_25895755825168385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_churned]) / COUNT([user_id])' />
      </column>
      <column caption='Active Users' datatype='integer' name='[Calculation_25895755825586178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_churned] = 0 THEN [user_id] END)' />
      </column>
